# Netlify _headers configuration for Airlock
# Configures COOP/COEP headers for SharedArrayBuffer + WASM support
# and MIME types for assets

# All hashed JS/CSS/WASM assets in /assets/*
# Vite output: index-[hash].js, duckdb-[hash].wasm, duckdb-browser-eh.worker-[hash].js
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Explicitly set WASM MIME type (Netlify auto-detects but being explicit helps)
/assets/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Web workers (used by DuckDB-WASM) and every other JS asset.
# NOTE: Vite hashes worker filenames as `duckdb-browser-eh.worker-<hash>.js`
# (the hash lands BETWEEN "worker" and ".js"), so a `*.worker.js` suffix
# pattern never matches the emitted filename. Netlify's `_headers` allows only
# one wildcard per rule, so match on the `.js` suffix instead — this covers
# the worker files and every other JS chunk; the extra CORP/Content-Type
# headers are harmless on the non-worker JS chunks too.
/assets/*.js
  Content-Type: application/javascript; charset=UTF-8
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin

# Demo data (bundled CSVs)
/demo/*
  Cache-Control: public, max-age=31536000, immutable

# Root HTML and any other .html files
# Must NOT be cached so SPA routing and deployments work correctly
/*
  Cache-Control: public, max-age=0, must-revalidate
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
