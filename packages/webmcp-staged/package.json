{
  "name": "webmcp-staged",
  "version": "0.2.0",
  "description": "Staged Agent Authority for tool-calling agents: the agent may propose actions but only a human can commit them. One gate, three transports — WebMCP pages, OpenAI-compatible tool loops, and plain MCP servers.",
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "human-in-the-loop",
    "staged-approval",
    "agent-safety",
    "tool-calling",
    "function-calling",
    "openai",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "vitest": "1.6.1",
    "fast-check": "3.23.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adilmohd04/airlock.git",
    "directory": "packages/webmcp-staged"
  },
  "homepage": "https://github.com/Adilmohd04/airlock/tree/main/packages/webmcp-staged",
  "bugs": "https://github.com/Adilmohd04/airlock/issues"
}
